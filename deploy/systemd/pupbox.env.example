PUPBOX_ADDR=0.0.0.0:8791
PUPBOX_CHAT_PROVIDER=dashscope
PUPBOX_VOICE_PROVIDER=dashscope
PUPBOX_EVENT_LOG_PATH=/var/lib/pupbox/events.jsonl
PUPBOX_EVENT_LOG_LIMIT=500
PUPBOX_TTS_CACHE_DIR=/var/lib/pupbox/tts-cache
PUPBOX_TTS_CACHE_LIMIT=256
PUPBOX_TTS_PREWARM=false
PUPBOX_SURPRISE_ENABLED=false
PUPBOX_XIAOZHI_ENABLED=true
PUPBOX_XIAOZHI_DEVICE_ID=00:00:00:00:00:00
PUPBOX_XIAOZHI_WS_URL=ws://192.168.1.2:8791/xiaozhi/v1/
PUPBOX_XIAOZHI_SILENCE_MS=650
PUPBOX_DASHSCOPE_CHAT_MODEL=qwen-plus-character
PUPBOX_DASHSCOPE_REALTIME_STT_MODEL=qwen3-asr-flash-realtime
PUPBOX_DASHSCOPE_FORCE_IPV4=true
PUPBOX_DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
PUPBOX_DASHSCOPE_TTS_VOICE=longhuhu_v3
PUPBOX_DASHSCOPE_TTS_FORMAT=opus
PUPBOX_DASHSCOPE_TTS_SAMPLE_RATE=24000
PUPBOX_DASHSCOPE_TTS_SPEED=0.88

# Add these only to /etc/pupbox/pupbox.env on the device:
# CHAT_ARCHIVE_QWEN_API_KEY=...
# PUPBOX_ACCESS_TOKEN=...
