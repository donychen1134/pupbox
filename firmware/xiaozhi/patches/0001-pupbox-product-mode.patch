+    void CheckCriticalBattery() {
+        int level = battery_monitor_->GetBatteryLevel();
+        bool charging = battery_monitor_->IsCharging();
+        ESP_LOGI(TAG, "Battery level=%d charging=%s", level, charging ? "true" : "false");
+
+        // A zero reading also represents an unplugged battery on this board.
+        if (level > 0 && level <= kCriticalBatteryLevel && !charging) {
+            critical_battery_samples_++;
+        } else {
+            critical_battery_samples_ = 0;
+        }
+        if (critical_battery_samples_ < kCriticalBatterySamples) {
+            return;
+        }
+
+        ESP_LOGW(TAG, "Critical battery confirmed, entering deep sleep");
+        Application::GetInstance().Alert(
+            Lang::Strings::BATTERY_LOW,
+            Lang::Strings::BATTERY_NEED_CHARGE,
+            "battery",
+            Lang::Sounds::OGG_LOW_BATTERY);
+        vTaskDelay(pdMS_TO_TICKS(2500));
